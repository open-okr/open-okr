# OpenOKR environment.
#
# Copy to .env and edit. Everything except DATABASE_URL has a working default,
# so a local checkout needs one line changed to boot.
#
# Never commit .env. Never log these values.

# --- Required ---------------------------------------------------------------

# The only service OpenOKR requires. Postgres 16 or newer, with the pgvector
# extension available.
DATABASE_URL=postgres://openokr:openokr@localhost:5432/openokr

# --- Optional, shown with their defaults ------------------------------------

# Owner-role connection for migrations. Unset means migrations run over
# DATABASE_URL. Production separates the two so the application role never
# owns the tables.
# DATABASE_ADMIN_URL=

# Signs session cookies and encrypts two-factor secrets. Development falls
# back to a public placeholder so a fresh checkout runs; production refuses
# to start with it. Generate one with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# The instance's public origin. Passkeys are bound to it, so it must match
# the address people actually use.
# BETTER_AUTH_URL=http://localhost:3000

# development | test | production
# NODE_ENV=development

# debug | info | warn | error
# LOG_LEVEL=info

# Port the web application listens on.
# PORT=3000

# --- Instance secrets -------------------------------------------------------

# The root key for every stored credential: mail passwords, channel
# credentials and provider keys. Losing it means losing them, because it never
# touches the database.
#
# Production requires it. Development generates one per process, so anything
# sealed locally does not survive a restart; set this if you want it to.
#
# The compose target generates this on first run, so a self-hosted install
# never sets it by hand. Generate one with: openssl rand -base64 32
# OPENOKR_ENCRYPTION_KEY=

# Retired root keys, comma-separated. Rotation puts the old key here so
# secrets sealed before it still open, and the lifecycle helper removes it once
# every secret has been re-wrapped. Empty in normal operation.
# OPENOKR_PREVIOUS_ENCRYPTION_KEYS=

# --- Instance settings, all optional ----------------------------------------
#
# These bootstrap an instance. A value set through the wizard or admin screens
# wins over them, so changing a setting in the product survives a restart.

# OPENOKR_INSTANCE_NAME=OpenOKR
# OPENOKR_DEFAULT_LANGUAGE=en
# OPENOKR_TELEMETRY=false

# auto | open | invite_only. 'auto' opens registration until the instance is
# claimed and closes it afterwards.
# OPENOKR_REGISTRATION=auto

# Mail. 'console' writes messages to the log and needs no server, which is why
# a fresh instance works with none of this set.
# OPENOKR_MAIL_TRANSPORT=console
# OPENOKR_MAIL_HOST=
# OPENOKR_MAIL_PORT=587
# OPENOKR_MAIL_SECURE=false
# OPENOKR_MAIL_USER=
# OPENOKR_MAIL_PASSWORD=
# OPENOKR_MAIL_FROM=openokr@localhost
