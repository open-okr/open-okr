# OpenOKR environment.
#
# Copy to apps/web/.env and edit. Everything except DATABASE_URL has a working
# default, so a local checkout needs one line changed to boot.
#
# It goes in apps/web, not the repository root. Nothing here loads a dotenv
# file: Next.js reads apps/web/.env by itself, and a file at the root is
# silently ignored. The command line tools read the process environment
# instead, so export DATABASE_URL or pass it inline for pnpm db:migrate and
# the other db commands. CONTRIBUTING.md walks through a local run.
#
# Never commit .env. Never log these values.

# --- Required ---------------------------------------------------------------

# The only service OpenOKR requires. Postgres 16 or newer. No extension is
# needed today; pgvector arrives with embeddings and retrieval (P4-T13), and
# semantic search degrades to full text wherever it is unavailable.
#
# This value matches the database `pnpm db:up` starts, which publishes on
# 55432 rather than 5432 so a Postgres already installed on this machine is
# never touched. Point it somewhere else for your own server.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/openokr

# --- Optional, shown with their defaults ------------------------------------

# Owner-role connection for migrations. Unset means migrations run over
# DATABASE_URL. Production separates the two so the application role never
# owns the tables.
# DATABASE_ADMIN_URL=

# Signs session cookies and encrypts two-factor secrets. Development falls
# back to a public placeholder so a fresh checkout runs; production refuses
# to start with it. Generate one with: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# The instance's public origin. Passkeys are bound to it, so it must match
# the address people actually use.
# BETTER_AUTH_URL=http://localhost:3000

# Hostnames other than localhost allowed to request Next dev assets in
# development. Needed when the app is reached through a local domain (a reverse
# proxy on http://openokr.test) or from a phone on the same network by LAN
# address, because Next blocks cross-origin dev requests by default and every
# asset then returns 403. Comma separated. No effect on a production build.
# OPENOKR_DEV_ORIGINS=openokr.test,192.168.1.20

# development | test | production
# NODE_ENV=development

# debug | info | warn | error. debug also logs responses a browser cancelled
# before they finished, which are otherwise left out as noise.
# LOG_LEVEL=info

# Port the web application listens on.
# PORT=3000

# Names a deployment, for the stale-tab reload (P2-T10): a tab loaded before
# a release notices the running server's id has changed and reloads once.
# Unset generates a fresh id per process start, which only tells restarts
# apart, not two instances of the same release — set this to a git SHA or a
# build number wherever more than one process serves the same release.
# APP_BUILD_ID=

# Whether this process drains the outbox, which is what delivers invitation
# emails, live session events and content indexing: "on" (the default), "off",
# or "elsewhere". Several processes draining at once is safe: rows are claimed
# with a lease. Set "elsewhere" on your serving replicas if you would rather
# run one dedicated drainer than have all of them poll: they then drain
# nothing, but the copilot still answers in the background and /api/metrics
# still serves the queue's gauges. "off" means not here, and perhaps nowhere.
# OPENOKR_RELAY=on

# Whether this process runs the scheduler: the Coach, the Champion, the
# reminders and every other job on a clock. The same three values. With
# "elsewhere", /api/status judges the stamp the other process writes; with
# "off" it reports the scheduler operational whatever happens, for an
# instance that runs its sweeps by hand.
# OPENOKR_SCHEDULER=on

# How long a stopping process may finish the work in flight, in seconds, from
# 1 to 300. On SIGTERM the relay finishes the row it is sending and hands the
# rest of its batch back, the scheduler hands back any job still running three
# seconds before this, and actions in flight are waited for. Whatever is left
# at the bound is retried elsewhere, as after a crash. Give the container a
# stop timeout above this plus about 15 seconds: Compose waits 30.
# OPENOKR_SHUTDOWN_SECONDS=20

# Where files live: exports today, attachments when they land. Relative to the
# working directory, and the compose file mounts a named volume at this name,
# so a container keeps its files across an upgrade with nothing set. An
# S3-compatible driver behind the same port is an alternative, not a
# requirement.
# OPENOKR_STORAGE_ROOT=storage

# --- Instance secrets -------------------------------------------------------

# The root key for every stored credential: mail passwords, channel
# credentials and provider keys. Losing it means losing them, because it never
# touches the database.
#
# Production requires it. Development generates one per process, so anything
# sealed locally does not survive a restart; set this if you want it to.
#
# The compose target generates this on first run, so a self-hosted install
# never sets it by hand. Generate one with: openssl rand -base64 32
# OPENOKR_ENCRYPTION_KEY=

# Retired root keys, comma-separated. Rotation puts the old key here so
# secrets sealed before it still open, and the lifecycle helper removes it once
# every secret has been re-wrapped. Empty in normal operation.
# OPENOKR_PREVIOUS_ENCRYPTION_KEYS=

# --- Instance settings, all optional ----------------------------------------
#
# These bootstrap an instance. A value set through the wizard or admin screens
# wins over them, so changing a setting in the product survives a restart.

# What the tab title, the sign-in page, every email and every chat message call
# this instance. The wizard keeps it unless you type a different name there.
# OPENOKR_INSTANCE_NAME=OpenOKR
# OPENOKR_DEFAULT_LANGUAGE=en
# OPENOKR_TELEMETRY=false

# auto | open | company_domains | invite_only. 'auto' opens registration until
# the instance is claimed and closes it afterwards. 'company_domains' admits a
# company address and refuses Gmail and other free mail without an invitation.
# A choice saved on Admin > General wins over this. The account the setup
# wizard creates is admitted whatever this says.
# OPENOKR_REGISTRATION=auto

# Whose address a request is counted under, for every per-address limit, the
# sign-in hold and the session list. Unset reads X-Forwarded-For only when it
# holds one address. Set at most one; docs/install/behind-a-proxy.md says which.
# The proxies in front of the instance, as addresses or CIDR ranges.
# OPENOKR_TRUSTED_PROXIES=10.0.1.0/24
# The one header your CDN writes the visitor's address into. Only when the
# server is reachable through that CDN and nothing else.
# OPENOKR_CLIENT_ADDRESS_HEADER=cf-connecting-ip

# Mail. 'console' writes messages to the log and needs no server, which is why
# a fresh instance works with none of this set.
# OPENOKR_MAIL_TRANSPORT=console
# OPENOKR_MAIL_HOST=
# OPENOKR_MAIL_PORT=587
# OPENOKR_MAIL_SECURE=false
# OPENOKR_MAIL_USER=
# OPENOKR_MAIL_PASSWORD=
# OPENOKR_MAIL_FROM=openokr@localhost

# Virus scanning. Name a ClamAV daemon (clamd) and every uploaded file waits as
# "being checked" until clamd has scanned it; a file it flags is held back and
# never served. Empty means no scan, which is the default.
# OPENOKR_CLAMD_HOST=
# OPENOKR_CLAMD_PORT=3310

# How many reverse proxies stand between the internet and the server. The
# caller's address, which every sign-in limit counts, is the X-Forwarded-For
# entry that many places from the right. The bundled Caddy and a single
# ingress controller are one proxy, which is the default. A cloud load balancer
# in front of the ingress makes it 2. 0 means no proxy: the header is ignored
# and every caller shares one limit.
# OPENOKR_TRUSTED_PROXY_HOPS=1

# Error reports. Every unexpected error is a JSON line in the log either way.
# Name the DSN of a tracker that speaks Sentry's protocol (Sentry, GlitchTip,
# Bugsink) to also send each one there. Empty sends nothing, which is the
# default. The DSN is a credential: never commit it.
# OPENOKR_ERROR_DSN=
# OPENOKR_ERROR_ENVIRONMENT=production
