# Dependencies
node_modules/

# Build output
.next/
dist/
out/
build/

# Tooling caches
.turbo/
coverage/
*.tsbuildinfo

# Flakiness reports. The quarantine list (test-quarantine.json) is committed.
.flaky/

# Environment files. Commit only .env.example.
.env
.env.*
!.env.example

# OS and editor noise
.DS_Store
*.pem
*.log

# Next.js generates this and its contents differ between dev and build.
next-env.d.ts

# What the self-hosted lifecycle helper writes when it is run from inside a
# checkout. Both are real secrets: secrets/app.env carries the instance root
# key, and a backup directory carries an encrypted dump of whatever was in the
# database. Neither was ignored until the smoke test was first run on this
# machine, on 20 September 2026, and left a pair of backups sitting untracked
# where git offers to commit them.
/deploy/docker/secrets/
/deploy/docker/backups/

# Playwright
/playwright-report/
/test-results/
/blob-report/
# Scratch output from driving a browser by hand during verification. Session
# debris, never a build artefact worth keeping.
/.playwright-mcp/
