{
  "name": "@openokr/agents",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "ai:evaluate": "node --experimental-strip-types --no-warnings --env-file-if-exists=../../.env src/bin/evaluate.ts",
