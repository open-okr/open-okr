    "@openokr/db": "workspace:*",
    "@openokr/method": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openokr/test-support": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
