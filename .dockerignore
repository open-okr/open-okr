# Everything the image does not need. Keeping this tight is most of the build
# speed: the context is sent to the daemon before anything runs.
node_modules
**/node_modules
.next
**/.next
.turbo
**/.turbo
dist
**/dist
coverage
**/coverage

.git
.github
.flaky
test-results
playwright-report
e2e

docs
deploy/helm
deploy/cloud
deploy/docker/secrets

# Every env file, at any depth: a nested one, such as a developer's
# apps/web/.env, would otherwise reach the build stage with whatever real
# values it holds (UAT 0.8.0 Q-11). The example alone is wanted.
.env
.env.*
**/.env
**/.env.*
!.env.example
*.log

.DS_Store
