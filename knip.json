{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "e2e/*.spec.ts",
        "e2e/prepare-database.ts",
        "e2e/p0-flows.ts",
        "e2e/repair-standalone-links.ts",
        "deploy/docker/migrate.ts",
        "playwright.dev.config.ts"
      ],
      "ignoreBinaries": ["openssl"]
    },
    "apps/web": {
      "entry": [
        "instrumentation.node.ts",
        "public/fonts/noto-sans-arabic/fonts.css",
        "public/fonts/noto-sans-sc/fonts.css",
        "test/**/*.test.ts"
      ]
    },
    "packages/core": {
      "ignoreBinaries": ["openssl"]
    },
    "packages/test-support": {
      "entry": ["bin/*.ts", "fixtures/**/vitest.config.ts"]
    },
    "packages/ui": {
      "ignoreDependencies": ["motion"]
    }
  }
}
