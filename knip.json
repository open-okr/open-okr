{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "e2e/*.spec.ts",
        "e2e/prepare-database.ts",
        "deploy/docker/migrate.ts"
      ]
    },
    "apps/web": {
      "entry": ["instrumentation.node.ts", "test/**/*.test.ts"]
    },
    "packages/test-support": {
      "entry": ["bin/*.ts", "fixtures/**/vitest.config.ts"]
    },
    "packages/ui": {
      // CLAUDE.md's locked stack: "SmoothUI on Motion". Installed ahead of
      // the first SmoothUI component that animates with it, the same way
      // the design system itself is added at build time before any screen
      // uses it — not dead, just not wired to a consumer yet.
      "ignoreDependencies": ["motion"]
    }
  }
}
