{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": [
        "TEST_DB_PORT",
        "TEST_PGBOUNCER_PORT",
        "TEST_DB_HOST",
        "DATABASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "passThroughEnv": [
        "TEST_DB_PORT",
        "TEST_PGBOUNCER_PORT",
        "TEST_DB_HOST",
        "DATABASE_URL"
      ]
    },
    "typecheck": {}
  }
}
