#!/bin/sh
# The OpenOKR lifecycle helper (P1-T09, backup/restore P6-T06, verify P8-T06d).
#
#   ./openokr up              start, generating every secret on first run
#   ./openokr status          what is running, and whether it is healthy
#   ./openokr logs            follow the application log
#   ./openokr upgrade         pull, restart, re-run migrations, report
#   ./openokr rotate-key      re-wrap stored secrets under a new root key
#   ./openokr backup          encrypted database dump + blob copy, with checksum
#   ./openokr restore F       restore from a backup directory created by backup
#   ./openokr verify-backup F prove a backup would restore, without touching the live database
#   ./openokr down            stop, keeping data
#   ./openokr destroy         stop and delete every volume
#
# Written in POSIX shell on purpose. It has to run before the application does,
# including when the application will not start, so it cannot be a Node script
# inside the image it is meant to diagnose.
set -eu

cd "$(dirname "$0")"

SECRETS_DIR="./secrets"
APP_ENV="$SECRETS_DIR/app.env"
DB_ENV="$SECRETS_DIR/db.env"

log() { echo "openokr: $1"; }
fail() { echo "openokr: $1" >&2; exit 1; }

# Paths inside a container are not paths on this host, and one shell disagrees.
#
# Git Bash on Windows rewrites an argument that looks like an absolute path
# before handing it to a native program, so `docker exec app node /app/...`
# arrives as `/app/C:/Program Files/Git/app/...` and the command fails on a
# module that was never missing. `rotate-key` failed that way the first time
# this script was run on Windows with Docker Desktop, on 20 September 2026, and
# the smoke test reported only "rotate-key failed" because it hides the output.
#
# Both variables are read by that shell alone. Every other system, including
# the Linux hosts this script is written for and continuous integration, has
# no use for them and ignores them.
MSYS_NO_PATHCONV=1
MSYS2_ARG_CONV_EXCL='*'
export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL

compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
  else
    fail "Docker Compose is not installed. See https://docs.docker.com/compose/install/"
  fi
}

# 32 random bytes, base64. openssl is on nearly every host; the shell fallback
# covers the ones where it is not, rather than failing at the first step of a
# first install.
random_key() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 32
  else
    head -c 32 /dev/urandom | base64 | tr -d '\n'
  fi
}

# A password for a connection string: base64 would need URL-escaping, and an
# escaping bug in a generated password is a bad way to spend an afternoon.
random_password() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 24
  else
    head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'
  fi
}

generate_secrets() {
  if [ -f "$APP_ENV" ]; then
    return 0
  fi

  # Secrets missing but a database volume present means the secrets were
  # deleted from under a running instance. Postgres sets its password only
  # when it initialises an empty data directory, so generating a fresh one
  # here produces an instance that can never authenticate, and the error it
  # gives is about the database rather than about the missing file.
  #
  # Worse, OPENOKR_ENCRYPTION_KEY would also be new, and every stored
  # credential sealed with the old one would be unreadable. So this refuses.
  #
  # The volume is named after the Compose project, so it is this project's
  # volume that counts. Checking the default name alone refused every second
  # stack on a host that runs a normal install, the demo reset and the UAT
  # staging stack included, over a volume that belongs to somebody else.
  if docker volume inspect "${COMPOSE_PROJECT_NAME:-openokr}_db-data" >/dev/null 2>&1; then
    echo "openokr: there is an existing database volume but no $APP_ENV." >&2
    echo "openokr: generating new secrets now would leave an instance that" >&2
    echo "openokr: cannot sign in and cannot read its stored credentials." >&2
    echo "" >&2
    echo "openokr: restore $APP_ENV from your backup, or run" >&2
    echo "openokr: './openokr destroy' to start over and lose the data." >&2
    exit 1
  fi

  log "generating secrets (first run)"
  mkdir -p "$SECRETS_DIR"
  # Before writing anything into it. These files are the difference between an
  # encrypted instance and a readable one.
  chmod 700 "$SECRETS_DIR"

  db_password="$(random_password)"

  umask 077
  cat > "$DB_ENV" <<EOF
# Generated by ./openokr on first run. Do not edit while the stack is running.
POSTGRES_USER=openokr
POSTGRES_DB=openokr
POSTGRES_PASSWORD=$db_password
EOF

  cat > "$APP_ENV" <<EOF
# Generated by ./openokr on first run.
#
# OPENOKR_ENCRYPTION_KEY is the root key for every stored credential. Losing it
# means losing them: mail passwords, channel credentials and provider keys all
# become unreadable. Back this file up somewhere other than this server.
DATABASE_URL=postgres://openokr:$db_password@db:5432/openokr
BETTER_AUTH_SECRET=$(random_key)
OPENOKR_ENCRYPTION_KEY=$(random_key)
BETTER_AUTH_URL=$(public_url)
EOF

  chmod 600 "$APP_ENV" "$DB_ENV"
  log "secrets written to $SECRETS_DIR (mode 600). Back up $APP_ENV."
}

# The origin the browser will use. Passkeys are bound to it, and so are the
# links in any mail the instance sends, so getting it wrong is not cosmetic.
#
# This used to read OPENOKR_URL, which nothing sets and nothing documents. The
# documented variable is OPENOKR_DOMAIN, so a domain install wrote
# http://localhost into app.env on its first run and kept it forever, because
# secrets are generated once.
# The address a browser actually reaches this instance on.
#
# **The port is part of it** (P8-G06). This returned a bare `http://localhost`
# whatever `OPENOKR_HTTP_PORT` was set to, so an instance published on any port
# but 80 wrote that address into BETTER_AUTH_URL and then refused every sign-in
# with "Invalid origin", because the origin the browser sends carries the port.
# Worse, `reconcile_public_url` runs on every `up`, so an operator who fixed
# app.env by hand had it overwritten again on their next start. Found on
# 22 September 2026 on an instance running on 8088.
#
# A domain is left alone: `OPENOKR_DOMAIN` turns on automatic HTTPS, which means
# 443, and the standard port is never written into an origin.
public_url() {
  if [ -n "${OPENOKR_DOMAIN:-}" ]; then
    echo "https://$OPENOKR_DOMAIN"
  elif [ -n "${OPENOKR_HTTP_PORT:-}" ] && [ "${OPENOKR_HTTP_PORT}" != "80" ]; then
    echo "http://localhost:${OPENOKR_HTTP_PORT}"
  else
    echo "http://localhost"
  fi
}

# Keeps BETTER_AUTH_URL in step with OPENOKR_DOMAIN on every `up`, not only on
# the run that generated the secrets. An operator who adds a domain later would
# otherwise have to know to edit app.env by hand.
reconcile_public_url() {
  [ -f "$APP_ENV" ] || return 0
  wanted="$(public_url)"
  current="$(grep '^BETTER_AUTH_URL=' "$APP_ENV" 2>/dev/null | cut -d= -f2-)"
  [ "$current" = "$wanted" ] && return 0

  log "updating BETTER_AUTH_URL from '${current:-unset}' to '$wanted'"
  # `|| true` because grep reports "no lines matched" as a failure, and this
  # script runs under `set -e`.
  grep -v '^BETTER_AUTH_URL=' "$APP_ENV" > "$APP_ENV.next" || true
  echo "BETTER_AUTH_URL=$wanted" >> "$APP_ENV.next"
  mv "$APP_ENV.next" "$APP_ENV"
  chmod 600 "$APP_ENV"

  # Passkeys registered against the old origin will not work against the new
  # one. That is a browser rule, not something this can migrate.
  if [ -n "$current" ]; then
    log "note: passkeys registered against $current must be re-enrolled"
  fi
}

# Shared validation for a backup directory. Used by both `restore` and
# `verify-backup` (P8-T06d).
validate_backup_dir() {
  dir="$1"
  [ -n "$dir" ] || { echo "openokr: usage: ./openokr $2 <backup-directory>" >&2; exit 3; }
  [ -d "$dir" ] || { echo "openokr: $dir is not a directory" >&2; exit 3; }
  [ -f "$dir/checksum.sha256" ] || { echo "openokr: $dir has no checksum file" >&2; exit 3; }
  [ -f "$dir/db.dump.enc" ] || { echo "openokr: $dir has no database dump" >&2; exit 3; }
  [ -f "$dir/manifest.json" ] || { echo "openokr: $dir has no manifest" >&2; exit 3; }
  [ -f "$APP_ENV" ] || { echo "openokr: no $APP_ENV. Cannot decrypt without the root key." >&2; exit 3; }
}

# Verify a backup directory's checksum. Used by both `restore` and
# `verify-backup`.
verify_checksum() {
  dir="$1"
  log "verifying checksum..."
  if ! (cd "$dir" && sha256sum -c checksum.sha256 --quiet 2>/dev/null); then
    echo "openokr: checksum verification failed. The backup is damaged or was altered." >&2
    return 1
  fi
  log "checksum OK"
}

# Decrypt a backup's database dump, trying the current key and then any
# previous keys (P8-T06d). Sets $dump_path to the decrypted file on success.
#
# Extracted from the restore case so restore and verify-backup use the same
# logic. A second copy would be the one that gets the key fallback wrong.
#
# Arguments: $1 = backup directory
# Reads: $APP_ENV for OPENOKR_ENCRYPTION_KEY and OPENOKR_PREVIOUS_ENCRYPTION_KEYS
# Writes: $1/db.dump (caller is responsible for cleanup)
decrypt_dump() {
  _dd_dir="$1"
  _dd_enc_key="$(grep '^OPENOKR_ENCRYPTION_KEY=' "$APP_ENV" | cut -d= -f2-)"
  _dd_prev_keys="$(grep '^OPENOKR_PREVIOUS_ENCRYPTION_KEYS=' "$APP_ENV" | cut -d= -f2- || true)"

  _dd_try() {
    openssl enc -d -aes-256-cbc -pbkdf2 \
      -pass "pass:$1" \
      -in "$_dd_dir/db.dump.enc" \
      -out "$_dd_dir/db.dump" 2>/dev/null
  }

  if _dd_try "$_dd_enc_key"; then
    log "decrypted with current key"
    return 0
  fi

  # Try previous keys (comma-separated).
  _dd_old_ifs="$IFS"
  IFS=','
  for _dd_key in $_dd_prev_keys; do
    _dd_key="$(echo "$_dd_key" | tr -d ' ')"
    if [ -n "$_dd_key" ] && _dd_try "$_dd_key"; then
      IFS="$_dd_old_ifs"
      log "decrypted with a previous key"
      return 0
    fi
  done
  IFS="$_dd_old_ifs"

  echo "openokr: could not decrypt the database dump with any known key" >&2
  return 1
}

case "${1:-help}" in
  up)
    generate_secrets
    reconcile_public_url
    # A bare hostname turns on automatic HTTPS; the default stays plain HTTP.
    if [ -n "${OPENOKR_DOMAIN:-}" ]; then
      OPENOKR_SITE="$OPENOKR_DOMAIN"
      export OPENOKR_SITE
      log "serving https://$OPENOKR_DOMAIN with an automatic certificate"
    fi
    compose up -d
    log "waiting for the instance to become healthy"
    waited=0
    until [ "$(compose ps -q app | xargs -r docker inspect -f '{{.State.Health.Status}}' 2>/dev/null || echo starting)" = "healthy" ]; do
      waited=$((waited + 3))
      if [ "$waited" -ge 180 ]; then
        echo "openokr: the application did not become healthy in 180s." >&2
        echo "openokr: run './openokr logs' to see why." >&2
        exit 1
      fi
      sleep 3
    done
    # The application being healthy is not the same as the instance being
    # reachable: the proxy sits in front of it and can be crash-looping on a
    # bad configuration while the application behind it is perfectly well.
    # Reporting "ready" on the application alone is exactly the kind of gate
    # that passes while checking nothing.
    proxy_state="$(compose ps -q proxy | xargs -r docker inspect -f '{{.State.Status}}' 2>/dev/null || echo missing)"
    if [ "$proxy_state" != "running" ]; then
      echo "openokr: the application is healthy but the proxy is '$proxy_state'." >&2
      echo "openokr: the instance is not reachable. Run './openokr logs proxy'." >&2
      exit 1
    fi

    log "ready. Open ${OPENOKR_DOMAIN:+https://$OPENOKR_DOMAIN}${OPENOKR_DOMAIN:-http://localhost${OPENOKR_HTTP_PORT:+:$OPENOKR_HTTP_PORT}} to finish setup."
    ;;

  down)
    compose down
    log "stopped. Data is kept; './openokr up' brings it back."
    ;;

  destroy)
    printf 'This deletes the database, uploaded files and certificates. Type the word DELETE to confirm: '
    read -r confirmation
    [ "$confirmation" = "DELETE" ] || fail "not confirmed, nothing was removed"
    compose down -v
    log "every volume removed. ./secrets still holds the old keys; delete it by hand if you mean to."
    ;;

  status)
    compose ps
    ;;

  logs)
    shift
    compose logs -f --tail=200 "${@:-app}"
    ;;

  upgrade)
    [ -f "$APP_ENV" ] || fail "no $APP_ENV. This instance has not been started yet."

    # **The backup happens before anything moves, and a failure stops the
    # upgrade** (P7-T09c). Migrations are forward-only, so once one has
    # applied the previous image may not run against the new schema. That
    # makes "restore the backup" the only rollback there is, and an upgrade
    # that proceeded without one would have removed the way back before
    # anybody knew they needed it.
    #
    # It reuses `./openokr backup` rather than dumping here. One backup
    # implementation and one restore implementation: a second dump written
    # for this path would be the one nobody tests and the one that turns out
    # not to restore.
    if [ "${OPENOKR_SKIP_BACKUP:-}" = "1" ]; then
      # The opt-out exists for an external database with its own backups.
      # Deliberately a variable and not a flag: it is a thing an operator
      # decides once about their deployment, not per upgrade.
      log "skipping the pre-upgrade backup (OPENOKR_SKIP_BACKUP=1)."
      log "your database had better be backed up somewhere else."
    else
      log "taking a backup before upgrading. Migrations are forward-only, so"
      log "this is the only way back."
      if ! "$0" backup; then
        fail "the pre-upgrade backup failed, so nothing was upgraded.
Fix the backup first: an upgrade with no backup cannot be rolled back,
because a forward-only migration leaves the previous image unable to read
the schema. Set OPENOKR_SKIP_BACKUP=1 only if this database is backed up
somewhere else."
      fi

      # Keep the last three and no more. A pre-upgrade dump is insurance for
      # the hours after an upgrade, not an archive: keeping every one fills
      # the disk on the host that can least afford it, and the third oldest
      # has never been the one anybody restored.
      backup_root="${OPENOKR_BACKUP_DIR:-./backups}"
      if [ -d "$backup_root" ]; then
        # shellcheck disable=SC2012
        ls -1d "$backup_root"/*/ 2>/dev/null | sort | head -n -3 | while read -r old; do
          log "removing old backup ${old}"
          rm -rf "$old"
        done
      fi
    fi

    # The rollback path, printed before anything changes rather than in a
    # document nobody has open at the time.
    current="$(compose images app --format json 2>/dev/null | head -c 400 || true)"
    log "current image: ${current:-unknown}"
    # **Not "run the previous tag"** (P7-T09c). That was wrong and was printed
    # here until 11 September 2026. Migrations are forward-only: once one has
    # applied, the previous image is looking at a schema it does not know, and
    # starting it is not a rollback but a second failure on top of the first.
    log "to roll back: ./openokr restore <the backup directory just written>,"
    log "then OPENOKR_IMAGE=<previous tag> ./openokr up. Restoring first is"
    log "the part that matters: the schema moved, so the old image cannot read"
    log "the new database."

    # A failed pull is not fatal. An air-gapped install has no registry to
    # reach and a locally built image has nothing to pull, and both are
    # supported deployments. The restart below still applies any migration the
    # image on disk carries.
    #
    # OPENOKR_SKIP_PULL avoids the wait entirely. Reaching a registry that is
    # not there takes a long time to fail, which is unhelpful for an air-gapped
    # host and for the smoke test, both of which already have their image.
    if [ "${OPENOKR_SKIP_PULL:-}" = "1" ]; then
      log "skipping the pull (OPENOKR_SKIP_PULL=1)"
    elif ! compose pull 2>/dev/null; then
      log "could not pull a newer image; continuing with the one on this host"
    fi

    # Migrations run in the entrypoint, so a restart applies them. They are
    # forward-only and take an advisory lock, so this is safe to repeat and
    # safe with more than one replica.
    compose up -d
    log "upgraded. Migrations ran on boot; './openokr logs' shows what applied."
    ;;

  rotate-key)
    [ -f "$APP_ENV" ] || fail "no $APP_ENV. This instance has not been started yet."
    log "rotating the root key. Stored secrets are re-wrapped; none is decrypted to disk."

    previous="$(grep '^OPENOKR_ENCRYPTION_KEY=' "$APP_ENV" | cut -d= -f2-)"
    [ -n "$previous" ] || fail "no OPENOKR_ENCRYPTION_KEY found in $APP_ENV"
    fresh="$(random_key)"

    # The old key stays on the ring so secrets sealed under it still open while
    # the re-wrap runs. It is removed once every secret is on the new key.
    cp "$APP_ENV" "$APP_ENV.backup"
    chmod 600 "$APP_ENV.backup"
    {
      grep -v '^OPENOKR_ENCRYPTION_KEY=\|^OPENOKR_PREVIOUS_ENCRYPTION_KEYS=' "$APP_ENV"
      echo "OPENOKR_ENCRYPTION_KEY=$fresh"
      echo "OPENOKR_PREVIOUS_ENCRYPTION_KEYS=$previous"
    } > "$APP_ENV.next"
    mv "$APP_ENV.next" "$APP_ENV"
    chmod 600 "$APP_ENV"

    compose up -d
    compose exec -T app node --experimental-strip-types --no-warnings \
      /app/migrator/packages/core/src/bin/rotate-keys.ts

    # Only now is the old key unnecessary.
    grep -v '^OPENOKR_PREVIOUS_ENCRYPTION_KEYS=' "$APP_ENV" > "$APP_ENV.next"
    mv "$APP_ENV.next" "$APP_ENV"
    chmod 600 "$APP_ENV"
    compose up -d

    log "rotated. The previous key is in $APP_ENV.backup; delete it once you are satisfied."
    ;;

  backup)
    # Encrypted backup: database dump + blob storage + manifest (P6-T06).
    #
    # The backup directory is self-contained: everything needed to restore
    # lives inside it. The database is pg_dump custom format (compressed,
    # supports parallel restore). Blobs are copied from the storage volume.
    # Both the dump and the blob tar are encrypted with the instance's root
    # key via openssl AES-256-CBC, so a backup on an untrusted host is still
    # sealed. A SHA-256 checksum covers the whole directory so a restore can
    # refuse a damaged one.
    [ -f "$APP_ENV" ] || fail "no $APP_ENV. This instance has not been started yet."

    encryption_key="$(grep '^OPENOKR_ENCRYPTION_KEY=' "$APP_ENV" | cut -d= -f2-)"
    [ -n "$encryption_key" ] || fail "no OPENOKR_ENCRYPTION_KEY in $APP_ENV"

    backup_root="${OPENOKR_BACKUP_DIR:-./backups}"
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    backup_dir="$backup_root/$timestamp"
    mkdir -p "$backup_dir"

    log "backing up to $backup_dir"

    # Database dump, encrypted.
    log "dumping database..."
    compose exec -T db pg_dump -U openokr -Fc openokr > "$backup_dir/db.dump.tmp"
    openssl enc -aes-256-cbc -salt -pbkdf2 \
      -pass "pass:$encryption_key" \
      -in "$backup_dir/db.dump.tmp" \
      -out "$backup_dir/db.dump.enc"
    rm -f "$backup_dir/db.dump.tmp"

    # Blob storage, encrypted.
    log "copying blob storage..."
    storage_id="$(compose ps -q app | head -1)"
    if [ -n "$storage_id" ] && docker cp "$storage_id:/app/storage" "$backup_dir/storage.tmp" 2>/dev/null; then
      tar -cf - -C "$backup_dir/storage.tmp" . | \
        openssl enc -aes-256-cbc -salt -pbkdf2 \
          -pass "pass:$encryption_key" \
          -out "$backup_dir/blobs.tar.enc"
      rm -rf "$backup_dir/storage.tmp"
      blob_count="$(find "$backup_dir" -name 'blobs.tar.enc' -exec wc -c {} \; | awk '{print $1}')"
    else
      log "no blob storage to back up (S3 or empty)"
      blob_count=0
    fi

    # Schema version (newest migration).
    schema_version="$(compose exec -T db psql -U openokr -d openokr -t -A \
      -c "SELECT name FROM _migrations ORDER BY name DESC LIMIT 1" 2>/dev/null || echo "unknown")"

    # Manifest.
    db_size="$(wc -c < "$backup_dir/db.dump.enc" | tr -d ' ')"
    cat > "$backup_dir/manifest.json" <<MANIFEST
{
  "timestamp": "$timestamp",
  "schemaVersion": "$schema_version",
  "dbBytes": $db_size,
  "blobBytes": $blob_count,
  "format": "openokr-backup-v1"
}
MANIFEST

    # Checksum over the whole directory.
    (cd "$backup_dir" && find . -type f ! -name 'checksum.sha256' -print0 | sort -z | xargs -0 sha256sum) \
      > "$backup_dir/checksum.sha256"

    # Retention: keep the N newest backups.
    retention="${OPENOKR_BACKUP_RETENTION:-7}"
    if [ -d "$backup_root" ]; then
      # List directories by name (which is a timestamp), remove all but the newest N.
      kept=0
      for d in $(ls -1dr "$backup_root"/*/); do
        kept=$((kept + 1))
        if [ "$kept" -gt "$retention" ]; then
          log "removing old backup: $d"
          rm -rf "$d"
        fi
      done
    fi

    log "backup complete: $backup_dir (db ${db_size} bytes, schema $schema_version)"
    ;;

  restore)
    # Restore from a backup directory created by ./openokr backup (P6-T06).
    #
    # Verifies the checksum before decrypting anything. Supports decryption
    # with a previous key (after a key rotation) by trying
    # OPENOKR_PREVIOUS_ENCRYPTION_KEYS if the current one fails.
    #
    # Decryption uses the shared decrypt_dump function (P8-T06d) so the
    # key-fallback logic is defined once for both restore and verify-backup.
    shift
    backup_dir="${1:-}"
    validate_backup_dir "$backup_dir" "restore"
    verify_checksum "$backup_dir" || fail "checksum verification failed"
    decrypt_dump "$backup_dir" || fail "decryption failed"

    # Restore database.
    log "restoring database..."
    compose exec -T db dropdb -U openokr --if-exists openokr
    compose exec -T db createdb -U openokr openokr
    cat "$backup_dir/db.dump" | compose exec -T db pg_restore -U openokr -d openokr --no-owner --no-privileges
    rm -f "$backup_dir/db.dump"

    # Restore blobs if the backup has them.
    if [ -f "$backup_dir/blobs.tar.enc" ]; then
      log "restoring blob storage..."
      openssl enc -d -aes-256-cbc -pbkdf2 \
        -pass "pass:$encryption_key" \
        -in "$backup_dir/blobs.tar.enc" | \
        docker cp - "$(compose ps -q app | head -1):/app/storage"
      log "blobs restored"
    fi

    # Run migrations in case the backup is from an older schema.
    log "running migrations..."
    compose exec -T app node --experimental-strip-types --no-warnings \
      /app/migrator/packages/db/src/migrate.ts 2>/dev/null || true

    log "restore complete from $backup_dir"
    log "verify with: ./openokr status"
    ;;

  verify-backup)
    # Prove a backup would restore, without touching the live database
    # (P8-T06d). Decrypts, loads into a temporary database, checks every
    # workspace, and drops the temporary database.
    #
    # Design: docs/design/p8-t06d-backup-verification.md
    #
    # Exit codes:
    #   0  every workspace passed every check
    #   1  at least one workspace failed (data issue, not a load failure)
    #   2  the backup could not be loaded (decrypt, restore, or query failure)
    #   3  usage error (missing argument, missing files)
    shift
    backup_dir="${1:-}"
    validate_backup_dir "$backup_dir" "verify-backup"

    verify_checksum "$backup_dir" || exit 2

    decrypt_dump "$backup_dir" || exit 2

    # A temporary database that is dropped on exit, success or failure.
    verify_db="openokr_verify_$(date -u +%Y%m%dT%H%M%SZ)"
    cleanup_verify() {
      rm -f "$backup_dir/db.dump"
      compose exec -T db dropdb -U openokr --if-exists "$verify_db" 2>/dev/null || true
    }
    trap cleanup_verify EXIT INT TERM

    log "loading into temporary database $verify_db..."
    compose exec -T db createdb -U openokr "$verify_db" || {
      echo "openokr: could not create temporary database $verify_db" >&2
      exit 2
    }
    cat "$backup_dir/db.dump" | compose exec -T db pg_restore -U openokr -d "$verify_db" --no-owner --no-privileges 2>/dev/null || {
      echo "openokr: pg_restore failed against $verify_db" >&2
      exit 2
    }
    rm -f "$backup_dir/db.dump"
    log "restore into $verify_db succeeded"

    # Read the expected schema version from the manifest.
    manifest_schema="$(sed -n 's/.*"schemaVersion"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$backup_dir/manifest.json")"

    # Helper: run a query against the temporary database.
    vq() {
      compose exec -T db psql -U openokr -d "$verify_db" -t -A -c "$1" 2>/dev/null
    }

    failures=0

    # Check 1: schema version matches the manifest.
    actual_schema="$(vq "SELECT name FROM _migrations ORDER BY name DESC LIMIT 1")"
    if [ -n "$manifest_schema" ] && [ "$manifest_schema" != "unknown" ]; then
      if [ "$actual_schema" = "$manifest_schema" ]; then
        log "  schema version: $actual_schema (matches manifest)"
      else
        log "  FAIL schema version: dump has '$actual_schema', manifest says '$manifest_schema'"
        failures=$((failures + 1))
      fi
    else
      log "  schema version: $actual_schema (manifest has no version to compare)"
    fi

    # Check 2: workspaces exist.
    workspace_rows="$(vq "SELECT id, slug FROM workspaces WHERE deleted_at IS NULL ORDER BY created_at")"
    workspace_count="$(echo "$workspace_rows" | grep -c '|' || true)"
    if [ "$workspace_count" -eq 0 ]; then
      log "  WARN no live workspaces found in the backup"
    else
      log "  workspaces: $workspace_count live"
    fi

    # Check 3 and 4: per-workspace member count and audit events.
    if [ "$workspace_count" -gt 0 ]; then
      echo "$workspace_rows" | while IFS='|' read -r ws_id ws_slug; do
        [ -n "$ws_id" ] || continue
        member_count="$(vq "SELECT count(*) FROM workspace_members WHERE workspace_id = '$ws_id' AND deleted_at IS NULL")"
        audit_count="$(vq "SELECT count(*) FROM audit_events WHERE workspace_id = '$ws_id'")"

        if [ "${member_count:-0}" -eq 0 ]; then
          log "  FAIL $ws_slug: 0 members (every workspace has at least its founding admin)"
          failures=$((failures + 1))
        elif [ "${audit_count:-0}" -eq 0 ]; then
          log "  FAIL $ws_slug: 0 audit events (provisioning writes audit events)"
          failures=$((failures + 1))
        else
          log "  ok   $ws_slug: $member_count member(s), $audit_count audit event(s)"
        fi
      done
      # The while-read runs in a subshell, so $failures inside it is lost.
      # Re-check by querying for the failure conditions.
      zero_members="$(vq "SELECT count(*) FROM workspaces w WHERE w.deleted_at IS NULL AND NOT EXISTS (SELECT 1 FROM workspace_members m WHERE m.workspace_id = w.id AND m.deleted_at IS NULL)")"
      zero_audit="$(vq "SELECT count(*) FROM workspaces w WHERE w.deleted_at IS NULL AND NOT EXISTS (SELECT 1 FROM audit_events a WHERE a.workspace_id = w.id)")"
      failures=$((failures + ${zero_members:-0} + ${zero_audit:-0}))
    fi

    # Report.
    if [ "$failures" -gt 0 ]; then
      log "verification FAILED: $failures issue(s) found"
      exit 1
    fi
    log "verification passed: $workspace_count workspace(s), schema $actual_schema"
    exit 0
    ;;

  *)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
